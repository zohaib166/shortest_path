{
  "name": "shortest-path-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-scripts": "5.0.1",
    "env-cmd": "10.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "env-cmd -f .env.development react-scripts start",
    "prod": "env-cmd -f .env.production react-scripts build",
    "build": "react-scripts build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
